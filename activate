#!/usr/bin/env bash
# ============================================================================
# venv-style activation of the Nova dev environment for an interactive shell.
#
#   source ./activate       (bash / zsh, repo root)
#   source ./activate.fish  (fish)
#   .\activate.ps1          (PowerShell)
#
# Applies the composed pm env (PATH + tool vars) to the CURRENT shell, with
# save/restore: `deactivate` undoes exactly what activation changed.
#
# `nova` becomes a shell function for this checkout. It runs only while the
# shell is inside this worktree and refuses outside it, so a sibling worktree
# keeps its own command. A prompt prefix names the worktree.
#
# Scripts and other processes do not source this: they run under
# `scripts/run-in-nova-env`. Both build on scripts/_activation.sh.
#
# Sync through setup before selecting the environment. PM owns freshness;
# activation does not maintain a second dependency stamp. It trusts the
# recorded tool digest instead of re-hashing every entry. `nova pm
# install` and `nova update` keep that check.
# ============================================================================
_NOVA_REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Options: `--test-extras a,b` selects the test environment's runtime extras
# (default: [all]); `--` ends options.
# A bare `source ./activate` inherits the caller's positional parameters.
# Ignore unrelated words so scripts with their own arguments can source it.
_nova_test_env="--test-environment"
_nova_expect_extras=""
for _nova_arg in "$@"; do
    if [ -n "$_nova_expect_extras" ]; then
        _nova_test_env="--test-environment=$_nova_arg"
        _nova_expect_extras=""
        continue
    fi
    case "$_nova_arg" in
        --) break ;;
        --test-extras) _nova_expect_extras=1 ;;
        --test-extras=*) _nova_test_env="--test-environment=${_nova_arg#--test-extras=}" ;;
        *) : ;;
    esac
done
if [ -n "$_nova_expect_extras" ]; then
    printf '%s\n' 'activate: --test-extras needs a comma-separated list' >&2
    unset _nova_arg _nova_test_env _nova_expect_extras
    return 2 2>/dev/null || exit 2
fi
unset _nova_arg _nova_expect_extras

# shellcheck source=scripts/_activation.sh
. "$_NOVA_REPO/scripts/_activation.sh"

if ! nova_sync "$_NOVA_REPO" "$_nova_test_env"; then
    printf '%s\n' 'activate: setup failed; shell environment unchanged' >&2
    unset _nova_test_env
    return 1 2>/dev/null || exit 1
fi
unset _nova_test_env

# Guard against double-sourcing: venv activate precedent (re-activating is a
# no-op re-save; we keep it idempotent by deactivating first). Key on the
# function, not the sentinel: child shells inherit __NOVA_ACTIVATED from an
# activated parent but never the function, and there is nothing to undo there.
if [ "$(type -t deactivate 2>/dev/null)" = "function" ]; then
    deactivate
fi

_nova_script="$(nova_compose_env "$_NOVA_REPO" sh)" || {
    echo "activate: could not compose the environment (see above)" >&2
    unset _nova_script
    return 1 2>/dev/null || exit 1
}
_nova_keys="$(printf '%s\n' "$_nova_script" | sed -n 's/^export \([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p' | tr '\n' ' ')"

# --- snapshot what we are about to change (deactivate restores this) ---
# __NOVA_ACTIVATED is part of the composed env below (it carries the
# installed-state path this environment was built from), so it is snapshotted
# and exported with every other key — no separate assignment here.
__NOVA_SAVED_PATH="$PATH"
for _nova_k in $_nova_keys; do
    eval "__NOVA_SAVED_$_nova_k=\"\${$_nova_k+set}\""
    eval "__NOVA_PRIOR_$_nova_k=\${$_nova_k-__NOVA_UNSET__}"
done
nova_apply_env "$_nova_script"

# This checkout, not whichever `nova` PATH finds. A function beats PATH, an
# alias, and a hashed command, including the MSIX execution alias.
__NOVA_WORKTREE="$_NOVA_REPO"
# The branch names the worktree. A checkout cannot share a branch with another.
__NOVA_WORKTREE_NAME="$(git -C "$_NOVA_REPO" rev-parse --abbrev-ref HEAD 2>/dev/null || :)"
if [ -z "$__NOVA_WORKTREE_NAME" ] || [ "$__NOVA_WORKTREE_NAME" = HEAD ]; then
    __NOVA_WORKTREE_NAME="$(basename "$_NOVA_REPO")"
fi
__NOVA_SAVED_PS1="${PS1-__NOVA_UNSET__}"
__NOVA_SAVED_PROMPT_COMMAND="${PROMPT_COMMAND-__NOVA_UNSET__}"

_nova_worktree_here() {
    _nova_top="$(git rev-parse --show-toplevel 2>/dev/null)" || return 1
    [ "$(cd "$_nova_top" && pwd -P)" = "$(cd "$__NOVA_WORKTREE" && pwd -P)" ]
}

nova() {
    _nova_worktree_here || {
        printf '%s\n' "nova: $(pwd) is outside $__NOVA_WORKTREE; refusing (the installed command is hidden while this checkout is active)" >&2
        return 1
    }
    (
        cd "$__NOVA_WORKTREE" || exit 1
        if [ -n "${PYTHON-}" ]; then
            exec "$PYTHON" nova "$@"
        elif [ -x .venv/Scripts/python.exe ]; then
            exec .venv/Scripts/python.exe nova "$@"
        elif [ -x .venv/bin/python ]; then
            exec .venv/bin/python nova "$@"
        elif [ -x venv/Scripts/python.exe ]; then
            exec venv/Scripts/python.exe nova "$@"
        elif [ -x venv/bin/python ]; then
            exec venv/bin/python nova "$@"
        else
            exec python nova "$@"
        fi
    )
}

_nova_prompt() {
    if [ "$__NOVA_SAVED_PS1" = "__NOVA_UNSET__" ]; then
        _nova_base_ps1=""
    else
        _nova_base_ps1="$__NOVA_SAVED_PS1"
    fi
    if _nova_worktree_here; then
        PS1="($__NOVA_WORKTREE_NAME) $_nova_base_ps1"
    else
        PS1="$_nova_base_ps1"
    fi
}

if [ -n "${PROMPT_COMMAND-}" ]; then
    PROMPT_COMMAND="_nova_prompt; ${PROMPT_COMMAND}"
else
    PROMPT_COMMAND=_nova_prompt
fi
_nova_prompt

deactivate() {
    export PATH="$__NOVA_SAVED_PATH"
    for _nova_k in $__NOVA_KEY_LIST; do
        eval "_nova_was=\"\$__NOVA_SAVED_$_nova_k\""
        eval "_nova_old=\"\$__NOVA_PRIOR_$_nova_k\""
        if [ "$_nova_was" != "set" ]; then
            unset "$_nova_k"
        else
            export "$_nova_k=$_nova_old"
        fi
        unset "__NOVA_SAVED_$_nova_k" "__NOVA_PRIOR_$_nova_k"
    done
    if [ "$__NOVA_SAVED_PS1" = "__NOVA_UNSET__" ]; then
        unset PS1
    else
        PS1="$__NOVA_SAVED_PS1"
    fi
    if [ "$__NOVA_SAVED_PROMPT_COMMAND" = "__NOVA_UNSET__" ]; then
        unset PROMPT_COMMAND
    else
        PROMPT_COMMAND="$__NOVA_SAVED_PROMPT_COMMAND"
    fi
    unset __NOVA_SAVED_PATH __NOVA_KEY_LIST __NOVA_ACTIVATED \
          __NOVA_WORKTREE __NOVA_WORKTREE_NAME \
          __NOVA_SAVED_PS1 __NOVA_SAVED_PROMPT_COMMAND
    unset -f deactivate nova _nova_worktree_here _nova_prompt
    unset _nova_k _nova_was _nova_old _nova_top
}

# remember the key list for deactivate (kept out of the loop vars above)
__NOVA_KEY_LIST="$_nova_keys"

# The composition library is not part of the user's shell.
unset -f nova_sync nova_bootstrap_python nova_compose_env nova_apply_env \
         nova_activation_current nova_ensure_env
unset _NOVA_REPO _nova_script _nova_keys _nova_k _nova_top
