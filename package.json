{
  "name": "@the-sanjeevkumar/nova-agent",
  "version": "1.0.3",
  "description": "Nova Agent - a universal AI agent you can run from any terminal. Installs a self-contained Python environment on first run.",
  "license": "MIT",
  "author": "Sanjeev Kumar",
  "repository": {
    "type": "git",
    "url": "https://github.com/the-sanjeevkumar/nova-agent.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "nova": "./npm/nova.js"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "npm/",
    "agent/",
    "nova_cli/",
    "tools/",
    "providers/",
    "plugins/",
    "skills/",
    "optional-skills/",
    "optional-mcps/",
    "locales/",
    "plugin-catalog/",
    "acp_adapter/",
    "cron/",
    "pm/",
    "nova_platform/",
    "tui_gateway/",
    "ui-tui/",
    "*.py",
    "pyproject.toml",
    "uv.lock",
    "pm/uv.lock",
    "pm/pyproject.toml",
    "README.md"
  ],
  "scripts": {
    "test": "node --test npm/nova.test.js"
  },
  "keywords": [
    "nova-agent",
    "ai-agent",
    "cli",
    "agent"
  ]
}
